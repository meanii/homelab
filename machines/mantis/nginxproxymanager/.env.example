# frpc (same value as beetle frps)
FRP_AUTH_TOKEN=<LONG_RANDOM_TOKEN>

# tinyauth
SECRET=<32_CHAR_RANDOM>
APP_URL=https://<tinyauth-host>.ghost.aniicrite.dev
USERS=<user:bcrypt-hash>

# tinyauth -> PocketID (OIDC)
GENERIC_CLIENT_ID=<POCKETID_CLIENT_ID>
GENERIC_CLIENT_SECRET=<POCKETID_CLIENT_SECRET>
GENERIC_AUTH_URL=https://pocketid.ghost.aniicrite.dev/authorize
GENERIC_TOKEN_URL=https://pocketid.ghost.aniicrite.dev/api/oidc/token
GENERIC_USER_URL=https://pocketid.ghost.aniicrite.dev/api/oidc/userinfo
GENERIC_SCOPES=openid email profile groups
GENERIC_NAME=PocketID
OAUTH_AUTO_REDIRECT=generic
