# /root/tinyauth.env in CT 107 (mode 600). tinyauth v5 reads TINYAUTH_* variables.
TINYAUTH_APPURL=https://auth.home.aniicrite.dev
TINYAUTH_LABELPROVIDER=none
TINYAUTH_ANALYTICS_ENABLED=false
TINYAUTH_DATABASE_PATH=/data/tinyauth.db
TINYAUTH_RESOURCES_PATH=/data/resources
TINYAUTH_OIDC_PRIVATEKEYPATH=/data/tinyauth_oidc_key
TINYAUTH_OIDC_PUBLICKEYPATH=/data/tinyauth_oidc_key.pub
# users.txt: one "user:bcrypt-hash" per line ($2a$ prefix), kept in a file so the
# $ signs are not touched by compose interpolation
TINYAUTH_AUTH_USERSFILE=/data/users.txt
TINYAUTH_AUTH_SECURECOOKIE=true
TINYAUTH_AUTH_SESSIONEXPIRY=604800
# NPM container on the compose network
TINYAUTH_AUTH_TRUSTEDPROXIES=172.18.0.0/16
# OAuth logins (PocketID, Google) are only accepted for these emails
TINYAUTH_OAUTH_WHITELIST=<EMAIL>
TINYAUTH_UI_TITLE=Homelab

# PocketID (passkeys). OIDC client in PocketID with callback
# https://auth.home.aniicrite.dev/api/oauth/callback/pocketid
TINYAUTH_OAUTH_PROVIDERS_POCKETID_NAME=PocketID
TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTID=<VALUE>
TINYAUTH_OAUTH_PROVIDERS_POCKETID_CLIENTSECRET=<VALUE>
TINYAUTH_OAUTH_PROVIDERS_POCKETID_AUTHURL=https://pocketid.ghost.aniicrite.dev/authorize
TINYAUTH_OAUTH_PROVIDERS_POCKETID_TOKENURL=https://pocketid.ghost.aniicrite.dev/api/oidc/token
TINYAUTH_OAUTH_PROVIDERS_POCKETID_USERINFOURL=https://pocketid.ghost.aniicrite.dev/api/oidc/userinfo
TINYAUTH_OAUTH_PROVIDERS_POCKETID_REDIRECTURL=https://auth.home.aniicrite.dev/api/oauth/callback/pocketid
TINYAUTH_OAUTH_PROVIDERS_POCKETID_SCOPES=openid email profile groups

# Google. OAuth client (Web application) in Google Cloud with redirect URI
# https://auth.home.aniicrite.dev/api/oauth/callback/google
TINYAUTH_OAUTH_PROVIDERS_GOOGLE_CLIENTID=<VALUE>
TINYAUTH_OAUTH_PROVIDERS_GOOGLE_CLIENTSECRET=<VALUE>
